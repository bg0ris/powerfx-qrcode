                                                    q.Value,
                                                    1
                                                ) = "1") <> (Mod(
                                                    m.r + m.c,
                                                    2
                                                ) = 0),
                                                "<rect x='" & (m.c) + 4 & "' y='" & (m.r) + 4 & "' width='1' height='1'/>",
                                                ""
                                            )
                                        )
                                    ) & "</svg>"
                                )
                            )
                        )
                    )
