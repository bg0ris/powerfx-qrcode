                                                i.Value = 6,
                                                7,
                                                8
                                            )) + 4 & "' width='1' height='1'/>" & "<rect x='" & (If(
                                                i.Value < 8,
                                                size - 1 - i.Value,
                                                8
                                            )) + 4 & "' y='" & (If(
                                                i.Value < 8,
                                                8,
                                                size - 15 + i.Value
                                            )) + 4 & "' width='1' height='1'/>",
                                            ""
                                        )
