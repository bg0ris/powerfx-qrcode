QrCode(value: Text): Text = With(
    {
        text: value,
        ascii: Concat(
            Sequence(
                95,
                32
            ),
            Char(Value)
        ),
        expT: "001002004008016032064128029058116232205135019038076152045090180117234201143003006012024048096192157039078156037074148053" & "106212181119238193159035070140005010020040080160093186105210185111222161095190097194153047094188101202137015030060120240" & "253231211187107214177127254225223163091182113226217175067134017034068136013026052104208189103206129031062124248237199147" & "059118236197151051102204133023046092184109218169079158033066132021042084168077154041082164085170073146057114228213183115" & "230209191099198145063126252229215179123246241255227219171075150049098196149055110220165087174065130025050100200141007014" & "028056112224221167083166081162089178121242249239195155043086172069138009018036072144061122244245247243251235203139011022" & "044088176125250233207131027054108216173071142001",
        logT: "000000001025002050026198003223051238027104199075004100224014052141239129028193105248200008076113005138101047225036015033" & "053147142218240018130069029181194125106039249185201154009120077228114166006191139098102221048253226152037179016145034136" & "054208148206143150219189241210019092131056070064030066182163195072126110107058040084250133186061202094155159010021121043" & "078212229172115243167087007112192247140128099013103074222237049197254024227165153119038184180124017068146217035032137046" & "055063209091149188207205144135151178220252190097242086211171020042093158132060057083071109065162031045067216183123164118" & "196023073236127012111246108161059082041157085170251096134177187204062090203089095176156169160081011245022235122117044215" & "079174213233230231173232116214244234168080088175"
    },
    If(
        Len(text) > 106,
        "",
        With(
            {
                L: Len(text),
                version: If(
                    Len(text) <= 17,
                    1,
                    Len(text) <= 32,
                    2,
                    Len(text) <= 53,
                    3,
                    Len(text) <= 78,
                    4,
                    5
                ),
                d: ForAll(
