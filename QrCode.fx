                    ) + 31
                )
            },
            With(
                {
                    kData: Switch(
                        version,
                        1,
                        19,
                        2,
                        34,
                        3,
                        55,
                        4,
                        80,
                        108
                    ),
                    kEc: Switch(
                        version,
                        1,
                        7,
                        2,
                        10,
                        3,
                        15,
                        4,
                        20,
                        26
                    ),
                    size: 17 + 4 * version
                },
                With(
                    {
                        wT: Switch(
                            kEc,
                            7,
                            "148014024213201087201167220028028107071087106083116188083107201255121060207188028213035068043060116028024086234068121083" & "220014210086035255106167148",
                            10,
                            "248224163122185093155188255253121211201211002123251186119255189157180002236030028126186188002017116164082163078028251155" & "217024132213063052163030123093034081136189124063082236002185076143203111189213164002211122218206121203136132116180201163" & "131052206143081024017157211224209131218076034217002189121248",
                            15,
                            "145217109006209156178074007058236122153045137103162188126116029205047000181150167227198045209214165117242172111178102136" & "171022125227153153100156240017253090104202223097240022167122155020088062160176032187169151236097171150236026095128208002" & "008095201025223151223136181058106211237111039120069233211025169202102000007169146006099051010016083233201187104178047074" & "160000089084065235103016069095032090111205178169057056241050154235010120008176253172029156128010156198083050065051039002" & "160017242116209133223103065198241084099111208062240117126006203015133103156056089006237128088156165188109028060015223010" & "057000146211095020100214162217038028203133128169160169106026155153209103145",
                            20,
                            "175154095082171210240080036214030007058076243240192149027049145074134059006065015211067053007077115023239168101000156027" & "068199181148107091165223084011030236156052238049093250000149167183186068250142133194038069195135221113211127002093101192" & "142187236029038173205132125093046148017009193083127049168240057205164074076063169085024036026156223247231193211238239243" & "025215058055005057165078072224106171063162247009113052023076220200055084141165040041035183065069055063223017221156115058" & "236245004103095214058097117230037217069171156148135236077007002065248253170159032200075120086037065106026046195030007030" & "232062061113250028248027137011120230183224036093069011053214073253148145179164045181146137075117035072024125038084067036" & "139031036059173009003003181027200097041078085132194223211080029068185048066023127003045248032058040165169205133165015240" & "250166152037235173023009164028159214165057063173142091065210189114246185230235066173179250170095141005076038250107006171" & "253068194027185037048059145113253103084055074029068148059082173000090194246152185036148061248004055058164236186181134095" & "253136000068114166068031253062065245200215205187183199074154157253173253189250029139073232002236220025057142167068145175",
                            "151030004081194241064009207171157111077109003144113033163026054199235032160240034010239212144016134225072005018158116144" & "050253170047135094109103150179205160020044087150119212070111003148046060204036004077040172003021001033106028179032024163" & "167010007163150255131196042168004046136200130095065251253006255106150235126035182009095058115070026020007211058253225200" & "136099020047201024006033103199238013248021078249044028110105248112110125013189030206108175216201253001109054228018082001" & "162116106243196216159143098187097174046059170101175047251021094026084022110180197108008157252244008215047001169120227156" & "071170108020065003135163065154255237167064243025254114011073088210017076076102156059206099095172047033082108242120219183" & "188003150095192048219172233045139076227046030136130040170113012050015222182088154120039093039234244003088209045076120174" & "189200200077253144231184035225004175164038144240035092178110078088233017169097013225136004050003174096236144162052060050" & "177173003203255223110003172210001187125253046036144109224152233051005165008085149190017203124255178244219088047098110058" & "004204116077059058035197107137232160108124177189203203092234048073215143112211168060158111091255239088195013230201065252" & "192177017003035039192011008159248007042046018157022076082128082217051154195213252124190173240093095114244216105020196148" & "005171040249214115243228132096217195065108149177144039150254252196110026131003072207192196215093041190200045096154201160" & "085050038120003025157243028070255111225009094116093151087130042200132051230232008060164154188243008106044115150070134064" & "022067100108252248130190228217013137165052175088183064108116249058163212016241109017136069007252087041243082195107005162" & "004182219167197162078095007119144194180100096132069108151093115128088197051144225222120237180001021009010150212081094178" & "239096136100093215214082239035233236035015242255110082248182167087239004077060178100017067116196249076255058152096184050" & "108154022018013035163044010030050077094180109022094192040022091059224174231012082065084228238126024020034151"
                        ),
                        cwT: ForAll(
                            Sequence(
                                kData,
                                0
                            ) As i,
                            {
                                i: i.Value,
                                c: If(
                                    i.Value = 0,
                                    64 + Trunc(L / 16),
                                    i.Value <= L + 1,
                                    If(
                                        i.Value = 1,
                                        Mod(
                                            L,
                                            16
                                        ),
                                        Mod(
                                            Index(
                                                d,
                                                i.Value - 1
                                            ).Value,
                                            16
                                        )
                                    ) * 16 + If(
                                        i.Value - 1 < L,
                                        Trunc(
                                            Index(
                                                d,
                                                i.Value
                                            ).Value / 16
                                        ),
                                        0
                                    ),
                                    If(
                                        Mod(
                                            i.Value - L - 2,
                                            2
                                        ) = 0,
                                        236,
                                        17
                                    )
                                )
                            }
                        )
                    },
                    With(
                        {
                            S: ForAll(
                                Sequence(
                                    kEc,
                                    0
                                ) As t,
                                With(
                                    {
                                        p: ForAll(
                                            cwT As cw,
                                            If(
                                                cw.c = 0,
                                                0,
                                                Value(
                                                    Mid(
                                                        expT,
                                                        Mod(
                                                            Value(
                                                                Mid(
                                                                    logT,
                                                                    cw.c * 3 + 1,
                                                                    3
                                                                )
                                                            ) + t.Value * (kEc + kData - 1 - cw.i),
                                                            255
                                                        ) * 3 + 1,
                                                        3
                                                    )
                                                )
                                            )
                                        )
                                    },
                                    {
                                        t: t.Value,
                                        s: Sum(
                                            Sequence(
                                                8,
                                                0
                                            ) As b,
                                            Power(
                                                2,
                                                b.Value
                                            ) * Mod(
                                                Sum(
                                                    p,
                                                    Mod(
                                                        Trunc(
                                                            Value / Power(
                                                                2,
                                                                b.Value
                                                            )
                                                        ),
                                                        2
                                                    )
                                                ),
                                                2
                                            )
                                        )
                                    }
                                )
                            )
                        },
                        With(
                            {
                                E: ForAll(
                                    Sequence(
                                        kEc,
                                        0
                                    ) As j,
                                    With(
                                        {
                                            p: ForAll(
                                                S As st,
                                                With(
                                                    {
                                                        w: Value(
                                                            Mid(
                                                                wT,
                                                                (j.Value * kEc + st.t) * 3 + 1,
                                                                3
                                                            )
                                                        )
                                                    },
                                                    If(
                                                        w = 0 || st.s = 0,
                                                        0,
                                                        Value(
                                                            Mid(
                                                                expT,
                                                                Mod(
                                                                    Value(
                                                                        Mid(
                                                                            logT,
                                                                            w * 3 + 1,
                                                                            3
                                                                        )
                                                                    ) + Value(
                                                                        Mid(
                                                                            logT,
                                                                            st.s * 3 + 1,
                                                                            3
                                                                        )
                                                                    ),
                                                                    255
                                                                ) * 3 + 1,
                                                                3
                                                            )
                                                        )
                                                    )
                                                )
                                            )
                                        },
                                        Sum(
                                            Sequence(
                                                8,
                                                0
                                            ) As b,
                                            Power(
                                                2,
                                                b.Value
                                            ) * Mod(
                                                Sum(
                                                    p,
                                                    Mod(
                                                        Trunc(
                                                            Value / Power(
                                                                2,
                                                                b.Value
                                                            )
                                                        ),
                                                        2
                                                    )
                                                ),
                                                2
                                            )
                                        )
                                    )
                                )
                            },
                            With(
                                {
                                    bits: Concat(
                                        cwT,
                                        Concat(
                                            Sequence(8) As b,
                                            Text(
                                                Mod(
                                                    Trunc(
                                                        c / Power(
                                                            2,
                                                            8 - b.Value
                                                        )
                                                    ),
                                                    2
                                                )
                                            )
                                        )
                                    ) & Concat(
                                        E,
                                        Concat(
                                            Sequence(8) As b,
                                            Text(
                                                Mod(
                                                    Trunc(
                                                        Value / Power(
                                                            2,
                                                            8 - b.Value
                                                        )
                                                    ),
                                                    2
                                                )
                                            )
                                        )
                                    ),
                                    moduleOrder: Filter(
                                        ForAll(
                                            Sequence(
                                                size * (size - 1),
                                                0
                                            ) As t,
                                            With(
                                                {
                                                    p: Trunc(t.Value / (2 * size)),
                                                    w: Mod(
                                                        t.Value,
                                                        2 * size
                                                    )
                                                },
                                                {
                                                    r: If(
                                                        Mod(
                                                            p,
                                                            2
                                                        ) = 0,
                                                        size - 1 - Trunc(w / 2),
                                                        Trunc(w / 2)
                                                    ),
                                                    c: If(
                                                        p < (size - 7) / 2,
                                                        size - 1 - 2 * p,
                                                        size - 2 - 2 * p
                                                    ) - Mod(
                                                        w,
                                                        2
                                                    )
                                                }
                                            )
                                        ),
                                        !((r < 9 && c < 9) || (r < 9 && c > size - 9) || (r > size - 9 && c < 9) || r = 6 || c = 6 || (version >= 2 && Abs(r - (size - 7)) <= 2 && Abs(c - (size - 7)) <= 2))
                                    )
                                },
                                "data:image/svg+xml;utf8," & EncodeUrl(
                                    "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 " & (size + 8) & " " & (size + 8) & "' shape-rendering='crispEdges'>" & "<rect width='100%' height='100%' fill='#fff'/>" & Concat(
                                        Table(
                                            {
                                                x: 0,
                                                y: 0
                                            },
                                            {
                                                x: size - 7,
                                                y: 0
                                            },
                                            {
                                                x: 0,
                                                y: size - 7
                                            }
                                        ),
                                        "<rect x='" & (x + 4) & "' y='" & (y + 4) & "' width='7' height='7'/>" & "<rect x='" & (x + 5) & "' y='" & (y + 5) & "' width='5' height='5' fill='#fff'/>" & "<rect x='" & (x + 6) & "' y='" & (y + 6) & "' width='3' height='3'/>"
                                    ) & Concat(
                                        Sequence(
                                            (size - 15) / 2,
                                            0
                                        ) As i,
                                        "<rect x='" & (8 + 2 * i.Value) + 4 & "' y='" & (6) + 4 & "' width='1' height='1'/>" & "<rect x='" & (6) + 4 & "' y='" & (8 + 2 * i.Value) + 4 & "' width='1' height='1'/>"
                                    ) & If(
                                        version >= 2,
                                        "<rect x='" & (size - 5) & "' y='" & (size - 5) & "' width='5' height='5'/>" & "<rect x='" & (size - 4) & "' y='" & (size - 4) & "' width='3' height='3' fill='#fff'/>" & "<rect x='" & (size - 3) & "' y='" & (size - 3) & "' width='1' height='1'/>",
                                        ""
                                    ) & "<rect x='" & (8) + 4 & "' y='" & (size - 8) + 4 & "' width='1' height='1'/>" & Concat(
                                        Sequence(
                                            15,
                                            0
